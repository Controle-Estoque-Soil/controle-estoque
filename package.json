{
  "name": "controle-estoque",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build -w @controle/shared && concurrently -n shared,api,web -c green,cyan,yellow \"npm run dev -w @controle/shared\" \"npm run dev -w @controle/api\" \"npm run dev -w @controle/web\"",
    "dev:api": "npm run build -w @controle/shared && npm run dev -w @controle/api",
    "dev:web": "npm run build -w @controle/shared && npm run dev -w @controle/web",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "api:migrate": "npm run prisma:migrate:deploy -w @controle/api",
    "api:seed": "npm run prisma:seed -w @controle/api",
    "lint": "eslint . --ext .ts,.tsx,.js,.cjs,.mjs --max-warnings=0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @controle/web",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^9.1.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
