# =========================================
# Inventory app production env (EC2)
# Copy to: deploy/aws-ec2/.env.prod
# =========================================

# Compose / project isolation (prevents collisions with cloud-monitoring)
COMPOSE_PROJECT_NAME=inventory

# Ports (use non-standard ports by default to avoid conflicts on shared EC2)
INVENTORY_API_PORT=8087
INVENTORY_PROXY_HTTP_PORT=18080
INVENTORY_PROXY_HTTPS_PORT=18443

# Postgres (containerized on same EC2)
INVENTORY_POSTGRES_DB=inventory_prod
INVENTORY_POSTGRES_USER=inventory
INVENTORY_POSTGRES_PASSWORD=change-me-strong-password

# API runtime
INVENTORY_DATABASE_URL=postgresql://inventory:change-me-strong-password@inventory-postgres:5432/inventory_prod?schema=public
INVENTORY_JWT_SECRET=replace-with-a-long-random-secret-min-16
INVENTORY_BCRYPT_SALT_ROUNDS=12
INVENTORY_CORS_ORIGINS=https://your-app.vercel.app,https://app.yourdomain.com
INVENTORY_TRUST_PROXY=true
INVENTORY_LOG_LEVEL=info
INVENTORY_ENABLE_SECURITY_HEADERS=true
INVENTORY_OUTBOUND_OPERATION_EMAIL_ENABLED=true
INVENTORY_OUTBOUND_OPERATION_EMAIL_TO=jose.queiroz@soiltech.com.br
INVENTORY_OUTBOUND_OPERATION_EMAIL_SUBJECT=Saida de Produto Soil Tecnologia
# Gmail em producao: preencher somente INVENTORY_SMTP_USER e INVENTORY_SMTP_PASS.
INVENTORY_SMTP_HOST=smtp.gmail.com
INVENTORY_SMTP_PORT=587
INVENTORY_SMTP_SECURE=false
INVENTORY_SMTP_USER=seu_gmail@gmail.com
INVENTORY_SMTP_PASS=sua_senha_de_app_google
INVENTORY_SMTP_FROM=seu_gmail@gmail.com

# Optional seed (only for first bootstrap / manual seed)
INVENTORY_SEED_ADMIN_EMAIL=
INVENTORY_SEED_ADMIN_PASSWORD=

# Proxy / TLS (Caddy)
INVENTORY_DOMAIN_API=api.yourdomain.com
INVENTORY_TLS_EMAIL=ops@yourdomain.com
