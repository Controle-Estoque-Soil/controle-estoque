# =========================================
# Local Docker Compose (dev / localhost)
# =========================================
POSTGRES_DB=controle_estoque
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

API_PORT=3333
JWT_SECRET=change-me-in-production-please
BCRYPT_SALT_ROUNDS=12
# Dev compatibility (single origin). Production uses CORS_ORIGINS (CSV).
CORS_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin12345
OUTBOUND_OPERATION_EMAIL_ENABLED=true
OUTBOUND_OPERATION_EMAIL_TO=jose.queiroz@soiltech.com.br
OUTBOUND_OPERATION_EMAIL_SUBJECT=Saida de Produto Soil Tecnologia
# Email de saida (Gmail): no dia a dia, basta preencher SMTP_USER e SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu_gmail@gmail.com
SMTP_PASS=sua_senha_de_app_google
SMTP_FROM=seu_gmail@gmail.com

# Web (apps/web) - build/runtime API base URL
NEXT_PUBLIC_API_URL=http://localhost:3333

# =========================================
# Production deploy placeholders (AWS EC2 + Vercel)
# Do NOT commit real values in this file.
# =========================================
INVENTORY_API_PORT=8087
INVENTORY_POSTGRES_PORT=5437
INVENTORY_POSTGRES_DB=inventory_prod
INVENTORY_POSTGRES_USER=inventory
INVENTORY_POSTGRES_PASSWORD=change-me
INVENTORY_DATABASE_URL=postgresql://inventory:change-me@inventory-postgres:5432/inventory_prod?schema=public
INVENTORY_JWT_SECRET=replace-with-long-random-secret
INVENTORY_CORS_ORIGINS=https://your-app.vercel.app,https://app.yourdomain.com
INVENTORY_PUBLIC_API_URL=https://api.yourdomain.com
INVENTORY_DOMAIN_API=api.yourdomain.com
INVENTORY_TLS_EMAIL=ops@yourdomain.com
INVENTORY_OUTBOUND_OPERATION_EMAIL_ENABLED=true
INVENTORY_OUTBOUND_OPERATION_EMAIL_TO=jose.queiroz@soiltech.com.br
INVENTORY_OUTBOUND_OPERATION_EMAIL_SUBJECT=Saida de Produto Soil Tecnologia
INVENTORY_SMTP_HOST=smtp.gmail.com
INVENTORY_SMTP_PORT=587
INVENTORY_SMTP_SECURE=false
INVENTORY_SMTP_USER=seu_gmail@gmail.com
INVENTORY_SMTP_PASS=sua_senha_de_app_google
INVENTORY_SMTP_FROM=seu_gmail@gmail.com

# GitHub Actions / EC2 deploy placeholders (secrets in GitHub, not in repo)
AWS_EC2_HOST=ec2-xx-xx-xx-xx.compute.amazonaws.com
AWS_EC2_USER=ubuntu
AWS_EC2_DEPLOY_PATH=/opt/inventory-app

# Vercel placeholders (configure in Vercel UI / GitHub)
VERCEL_PROJECT_NAME=inventory-web
