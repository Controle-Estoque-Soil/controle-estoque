# Postgres / Docker Compose
POSTGRES_DB=controle_estoque
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# API (apps/api)
API_PORT=3333
JWT_SECRET=change-me-in-production-please
BCRYPT_SALT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin12345

# Web (apps/web) - build-time for Next.js client
NEXT_PUBLIC_API_URL=http://localhost:3333

# Deploy placeholders (AWS / Vercel)
AWS_REGION=us-east-1
AWS_ECS_CLUSTER=your-cluster
AWS_ECS_SERVICE_API=your-api-service
AWS_ECR_OR_GHCR_IMAGE_API=ghcr.io/owner/controle-estoque-api
AWS_RDS_DATABASE_URL=postgresql://user:pass@host:5432/dbname?schema=public
VERCEL_ORG_ID=your-vercel-org-id
VERCEL_PROJECT_ID=your-vercel-project-id
VERCEL_TOKEN=your-vercel-token
