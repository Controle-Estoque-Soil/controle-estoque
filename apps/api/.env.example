PORT=3333
HOST=0.0.0.0
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/controle_estoque?schema=public
JWT_SECRET=change-me-in-production-please
BCRYPT_SALT_ROUNDS=12

# Development (single origin) - backward compatible
CORS_ORIGIN=http://localhost:3000

# Production (comma-separated origins, preferred)
# Example:
# CORS_ORIGINS=https://myapp.vercel.app,https://app.mydomain.com
CORS_ORIGINS=http://localhost:3000

# Behind reverse proxy (EC2 proxy / load balancer)
TRUST_PROXY=false
LOG_LEVEL=info
ENABLE_SECURITY_HEADERS=true

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin12345
