PORT=3333
HOST=0.0.0.0
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/controle_estoque?schema=public
JWT_SECRET=change-me-in-production-please
BCRYPT_SALT_ROUNDS=12

# Development (single origin) - backward compatible
CORS_ORIGIN=http://localhost:3000

# Production (comma-separated origins, preferred)
# Example:
# CORS_ORIGINS=https://myapp.vercel.app,https://app.mydomain.com
CORS_ORIGINS=http://localhost:3000

# Behind reverse proxy (EC2 proxy / load balancer)
TRUST_PROXY=false
LOG_LEVEL=info
ENABLE_SECURITY_HEADERS=true

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin12345

# Outbound operation email (PDF attachment)
OUTBOUND_OPERATION_EMAIL_ENABLED=true
OUTBOUND_OPERATION_EMAIL_TO=jose.queiroz@soiltech.com.br
OUTBOUND_OPERATION_EMAIL_SUBJECT=Saida de Produto Soil Tecnologia
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario_smtp
SMTP_PASS=senha_smtp
SMTP_FROM=no-reply@soiltech.com.br
